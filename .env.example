# ============================================
# Ankita Processors — Environment Variables
# ============================================
# Copy this file to .env and fill in values
# NEVER commit the .env file

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=ankita_processors

# ---- Application ----
APP_KEY=your-app-secret-key-min-32-chars
APP_URL=http://localhost:3333
APP_ENV=development
NODE_ENV=development

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ---- JWT ----
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Payment Provider ----
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# ---- Storage ----
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=

# ---- Logistics ----
LOGISTICS_PROVIDER=mock
LOGISTICS_API_KEY=
LOGISTICS_API_SECRET=

# ---- Email / SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@ankitaprocessors.com

# ---- Redis (optional, for caching/sessions) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Ports ----
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=3333
