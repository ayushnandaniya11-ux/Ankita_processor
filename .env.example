# ============================================
# Ankita Processors — Environment Variables
# ============================================
# Copy this file to .env and fill in values
# NEVER commit the .env file

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=ankita_processors

# ---- Application ----
APP_KEY=your-app-secret-key-min-32-chars
APP_URL=http://localhost:3333
APP_ENV=development
NODE_ENV=development

# ---- Frontend & CORS ----
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:4001
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001

# ---- Session Store & Cookie Store ----
# In production with HTTPS, set SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=ankita_session
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
REMEMBER_ME_DURATION_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# ---- JWT ----
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Payment Provider (Razorpay) ----
PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Storage ----
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=

# ---- Shipping Logistics (Delhivery API Integration) ----
LOGISTICS_PROVIDER=delhivery
DELHIVERY_MODE=sandbox # sandbox or production
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_CLIENT_ID=ANKITA_PROCESSORS
DELHIVERY_PICKUP_LOCATION=Jetpur Warehouse
DELHIVERY_SANDBOX_URL=https://staging-express.delhivery.com
DELHIVERY_PRODUCTION_URL=https://track.delhivery.com
DELHIVERY_WEBHOOK_SECRET=your_delhivery_webhook_secret


# ---- Indian GST E-Invoicing (IRP / GSP Integration) ----
E_INVOICE_ENABLED=false
E_INVOICE_ENVIRONMENT=sandbox
E_INVOICE_GSP_CLIENT_ID=
E_INVOICE_GSP_CLIENT_SECRET=

# ---- Email / SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=ankitaprocessors@gmail.com

# ---- Redis (optional, for caching/sessions) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Ports ----
WEB_PORT=4000
ADMIN_PORT=4001
API_PORT=3333
