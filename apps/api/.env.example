TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=LJYMuFl3BrmeoGxJAWCd4B1Kc8DvNNc1
NODE_ENV=development

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
# IMPORTANT: Update DB_PASSWORD and DB_USER 
# to match your local PostgreSQL credentials
# before running `pnpm db:migrate`!

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_pg_password_here
DB_DATABASE=ankita_processors
SESSION_DRIVER=cookie
LIMITER_STORE=database

# ==========================================
# EMAIL / SMTP CONFIGURATION
# ==========================================
# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# MAIL_FROM="Ankita Processors" <your-email@gmail.com>
#
# For Brevo / Resend / Sendgrid / etc:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=your-smtp-login
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM="Ankita Processors" <noreply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# ==========================================
# SHIPPING LOGISTICS: DELHIVERY API
# ==========================================
LOGISTICS_PROVIDER=delhivery
DELHIVERY_MODE=sandbox # sandbox or production
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_CLIENT_ID=ANKITA_PROCESSORS
DELHIVERY_PICKUP_LOCATION=Jetpur Warehouse
DELHIVERY_SANDBOX_URL=https://staging-express.delhivery.com
DELHIVERY_PRODUCTION_URL=https://track.delhivery.com
DELHIVERY_WEBHOOK_SECRET=your_delhivery_webhook_secret
